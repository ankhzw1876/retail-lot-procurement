{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI评估解释输出",
  "type": "object",
  "properties": {
    "recommendation": {
      "enum": [
        "BUY",
        "NEGOTIATE",
        "REJECT",
        "REWORK",
        "NEEDS_DATA",
        "INVALID"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "metric_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "text",
          "evidence_ids",
          "metric_keys"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 0,
      "maxItems": 5
    },
    "questions_to_verify": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "minItems": 0,
      "maxItems": 5
    }
  },
  "required": [
    "recommendation",
    "summary",
    "reasons",
    "risks",
    "questions_to_verify"
  ],
  "additionalProperties": false
}
